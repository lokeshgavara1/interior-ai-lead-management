# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Supabase (service role key: server-side only, never expose) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- AI receptionist (production: OpenAI) ---
# Leave OPENAI_BASE_URL empty for OpenAI. Set it only for another OpenAI-compatible
# server (e.g. Ollama at https://<host>/v1).
OPENAI_BASE_URL=
OPENAI_API_KEY=
# A current OpenAI model that supports Structured Outputs (JSON schema)
OPENAI_MODEL=
# How to get JSON out of the model: json_schema (server enforces the schema; OpenAI, Ollama)
# | json_object (JSON only; schema described in the prompt) | prompt (no response_format)
LLM_JSON_MODE=json_schema
# true = keep only facts the customer actually stated. Recommended for small models (7B),
# which tend to fill in plausible guesses. English/Hinglish keywords only.
LLM_FACT_GROUNDING=false
LLM_TIMEOUT_MS=60000

# --- Meta / WhatsApp Business Cloud API ---
# App secret: used to verify X-Hub-Signature-256 on every webhook
META_APP_SECRET=
# Any random string; paste the same value in the Meta webhook settings
META_VERIFY_TOKEN=
# Permanent system-user access token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# --- Message processing ---
# Wait this long after the last customer message before replying (merges bursts)
DEBOUNCE_MS=4000
# How many past messages the AI sees
HISTORY_LIMIT=20
# Follow-up worker interval
FOLLOWUP_INTERVAL_MS=900000
# Overdue-follow-up alert check interval
OVERDUE_INTERVAL_MS=600000

# --- Google Sheets CRM view (optional) ---
# Service account key: inline JSON or a path to the .json file. Share each client's
# sheet with the service account's client_email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEETS_SYNC_INTERVAL_MS=120000

# --- Email alerts (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

{
  "name": "lusa-lead-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI lead receptionist and lead management backend for interior design businesses",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "chat": "tsx src/cli/chat.ts",
    "test:live": "tsx src/cli/liveTest.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.4",
    "nodemailer": "^10.6.1",
    "openai": "^7.62.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
